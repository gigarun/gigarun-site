---
interface Props {
  iconClass?: string;
  linkClass?: string;
}

const { iconClass = 'w-4 h-4', linkClass = '' } = Astro.props;

const links = [
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/gigaruningenierie',
    path: 'M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z',
    viewBox: '0 0 320 512',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/gigarun',
    path: 'M100.28 448H7.4V148.9h92.88zm-46.44-341a53.85 53.85 0 1 1 53.85-53.84 53.86 53.86 0 0 1-53.85 53.84zM447.9 448h-92.68V302.4c0-34.7-.7-79.3-48.29-79.3-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3z',
    viewBox: '0 0 448 512',
  },
  {
    name: 'Fiche Google',
    href: 'https://share.google/tARfmKP7m5NggKJJ1',
    path: 'M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z',
    viewBox: '0 0 488 512',
  },
  {
    name: 'France Num — Activateurs',
    href: 'https://www.francenum.gouv.fr/activateurs/gigarun',
    path: 'M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z',
    viewBox: '0 0 24 24',
  },
];
---
<span class="flex items-center gap-3">
  {links.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener"
      aria-label={link.name}
      title={link.name}
      class={linkClass}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox={link.viewBox} fill="currentColor" class={iconClass}>
        <path d={link.path} />
      </svg>
    </a>
  ))}
</span>
