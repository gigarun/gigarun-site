---
---
<div id="cookie-banner" style="position:fixed;bottom:0;left:0;right:0;z-index:9999;padding:1rem;pointer-events:none;opacity:0;transition:opacity 0.3s;">
  <div class="cookie-banner-box" style="pointer-events:auto;max-width:56rem;margin:0 auto;background:#0D0028;border:1px solid rgba(124,58,237,0.35);border-radius:12px;padding:1.25rem 1.5rem;display:flex;flex-wrap:wrap;align-items:center;gap:1rem;box-shadow:0 -4px 32px rgba(0,0,0,0.5);">
    <div style="flex:1;min-width:200px;">
      <p style="color:#F1F0F7;font-size:.875rem;font-weight:600;margin:0 0 .25rem;">Ce site utilise des cookies</p>
      <p style="color:#9B99AA;font-size:.75rem;line-height:1.5;margin:0;">
        Seuls les cookies essentiels sont actifs par défaut. Avec votre accord, nous mesurons l'audience du site (Google Analytics, Ahrefs). Aucun cookie publicitaire.
        <a href="/confidentialite/" style="color:#A78BFA;text-decoration:underline;">En savoir plus</a>
      </p>
    </div>
    <div style="display:flex;gap:.75rem;flex-shrink:0;">
      <button id="cookie-refuse" style="color:#9B99AA;font-size:.75rem;font-weight:500;padding:.5rem 1rem;border-radius:.5rem;border:1px solid rgba(255,255,255,0.15);background:transparent;cursor:pointer;">
        Refuser
      </button>
      <button id="cookie-accept" style="background:#7C3AED;color:#fff;font-size:.75rem;font-weight:500;padding:.5rem 1rem;border-radius:.5rem;border:none;cursor:pointer;">
        Accepter
      </button>
    </div>
  </div>
</div>

<style>
  /* Sur mobile, laisse les coins bas libres pour les boutons accessibilité/remontée
     (SiteOverlays.astro, bottom-5, largeur 48px) : ce bandeau ne doit pas les recouvrir
     visuellement, même si le z-index des boutons passe désormais au-dessus. */
  @media (max-width: 640px) {
    .cookie-banner-box {
      /* !important nécessaire : l'élément porte margin:0 auto en style inline,
         qui prime sur toute règle de classe sans !important */
      margin-left: 4.75rem !important;
      margin-right: 4.75rem !important;
    }
  }
</style>

<script>
  // Consentement à la mesure d'audience.
  // Principe : AUCUN script ni cookie tiers avant un « Accepter ». Google Tag Manager (qui charge Google Analytics et Ahrefs)
  // n'est chargé par CE code qu'après consentement ; « Refuser » n'en charge jamais et efface les cookies de mesure déjà posés.
  // Le lien « Gérer mes cookies » du pied de page efface le choix et recharge la page : retirer son consentement est aussi simple que le donner.
  (function() {
    const GTM_ID = 'GTM-5KVX9JCB';
    const CLE = 'cookie-consent';
    const w = window as any;
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;

    const lire = () => { try { return localStorage.getItem(CLE); } catch (e) { return null; } };
    const ecrire = (v: string) => { try { localStorage.setItem(CLE, v); } catch (e) { /* stockage bloqué : le choix sera redemandé */ } };
    const effacer = () => { try { localStorage.removeItem(CLE); } catch (e) { /* rien */ } };

    // Efface les cookies de mesure Google (_ga, _ga_XXXX, _gid, _gat, _gcl_*) pour le domaine courant et ses variantes.
    function purgerCookiesMesure() {
      const hote = location.hostname;
      const domaines = [undefined, hote, '.' + hote.replace(/^www\./, '')];
      document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((n) => /^(_ga|_gid|_gat|_gcl_)/.test(n)).forEach((nom) => {
        domaines.forEach((d) => {
          document.cookie = nom + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (d ? '; domain=' + d : '');
        });
      });
    }

    // Charge Google Tag Manager, avec le consentement déclaré AVANT le chargement : mesure d'audience seulement,
    // publicité, données utilisateur et personnalisation restent refusées (cohérent avec « aucun cookie publicitaire »).
    function chargerMesure() {
      if (w.__mesureChargee) return;
      w.__mesureChargee = true;
      if (w.google_tag_manager && w.google_tag_manager[GTM_ID]) return; // déjà présent (ex. injection par Cloudflare pendant la transition)
      w.dataLayer = w.dataLayer || [];
      function gtag() { w.dataLayer.push(arguments); }
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      gtag('consent', 'update', { analytics_storage: 'granted' });
      w.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
      document.head.appendChild(s);
    }

    function masquer() {
      banner.style.opacity = '0';
      setTimeout(() => { banner.style.display = 'none'; }, 300);
    }

    const choix = lire();
    if (choix === 'accepted') {
      banner.style.display = 'none';
      chargerMesure();
    } else if (choix === 'refused') {
      banner.style.display = 'none';
      purgerCookiesMesure();
    } else {
      // Délai court pour éviter le flash au chargement
      setTimeout(() => { banner.style.opacity = '1'; }, 600);
    }

    document.getElementById('cookie-accept')!.onclick = function() {
      ecrire('accepted');
      masquer();
      chargerMesure();
    };
    document.getElementById('cookie-refuse')!.onclick = function() {
      ecrire('refused');
      masquer();
      purgerCookiesMesure();
    };

    // Retrait / modification du consentement depuis le pied de page
    const gerer = document.getElementById('cookie-manage');
    if (gerer) gerer.onclick = function() {
      effacer();
      purgerCookiesMesure();
      location.reload();
    };
  })();
</script>
