---
import Layout from '../../layouts/Layout.astro';
import { ALL_ITEMS } from '../../data/blog-items.js';

const tabs = [
  { id: 'tous', label: 'Tous', cats: [], types: [] },
  { id: 'cyber', label: 'Cybersécurité', cats: ['Cybersécurité','Sécurité','Sécurité email','NIS2'], types: [] },
  { id: 'infogerance', label: 'Infogérance', cats: ['Infogérance','Support IT','Expertise IT','Gestion IT'], types: [] },
  { id: 'infra', label: 'Infrastructure', cats: ['Infrastructure','Cloud','Sauvegarde'], types: [] },
  { id: 'm365', label: 'Microsoft 365', cats: ['Microsoft 365','Messagerie'], types: [] },
  { id: 'solutions', label: 'Solutions', cats: ['Location matériel','Téléphonie','E-Commerce'], types: [] },
  { id: 'ia', label: 'IA', cats: ['Intelligence artificielle'], types: [] },
  { id: 'gigarun', label: 'Gigarun', cats: ['Gigarun','Numérique responsable'], types: [] },
  { id: 'guides', label: '📘 Guides pratiques', cats: [], types: ['guide'] },
];

const guideCats = [
  { id: 'securite', label: 'Sécurité' },
  { id: 'messagerie', label: 'Messagerie' },
  { id: 'cloud', label: 'Cloud' },
  { id: 'poste', label: 'Poste de travail' },
  { id: 'ia', label: 'Intelligence artificielle' },
  { id: 'webmestre', label: 'Technique web' },
  { id: 'erp', label: 'ERP / Dolibarr' },
  { id: 'infogerance', label: 'Infogérance' },
  { id: 'forensique', label: 'Forensique' },
  { id: 'outils', label: 'Outils' },
];
---
<Layout title="Blog & Guides IT — Gigarun La Réunion" description="Articles, conseils pratiques et guides techniques pour les PME et TPE réunionnaises. Cybersécurité, infogérance, Microsoft 365, IA et plus.">
<section class="bg-[#07001C] pt-32 pb-20">
  <div class="max-w-6xl mx-auto px-6">

    <div class="max-w-2xl mb-10">
      <div class="inline-flex items-center gap-2 bg-[#110833] border border-[rgba(124,58,237,0.35)] px-4 py-1.5 mb-6 rounded-full">
        <span class="w-2 h-2 bg-[#7C3AED] rounded-full"></span>
        <span class="text-[#9B99AA] text-sm font-medium" id="blog-count">Blog & Guides · {ALL_ITEMS.length} ressources</span>
      </div>
      <h1 class="font-syne font-extrabold text-[#F1F0F7] mb-4" style="font-size:clamp(32px,5vw,48px);line-height:1.1;">Ressources IT pour<br/>les PME réunionnaises</h1>
      <p class="text-[#9B99AA] text-lg">Articles de fond, guides pratiques pas-à-pas et analyses pour les dirigeants et équipes IT de La Réunion.</p>
    </div>

    <div class="flex flex-wrap gap-2 mb-10" id="blog-tabs" role="tablist">
      {tabs.map((tab, i) => (
        <button
          role="tab"
          data-tab={tab.id}
          data-cats={JSON.stringify(tab.cats)}
          data-types={JSON.stringify(tab.types)}
          class={`tab-btn px-4 py-2 rounded-full text-sm font-medium transition-all border ${i === 0 ? 'bg-[#7C3AED] border-[#7C3AED] text-white' : 'bg-transparent border-[rgba(124,58,237,0.3)] text-[#9B99AA] hover:border-[#7C3AED] hover:text-[#F1F0F7]'}`}
          aria-selected={i === 0 ? 'true' : 'false'}>
          {tab.label}
        </button>
      ))}
    </div>

    <div class="relative mb-8 max-w-md">
      <input type="search" id="blog-search" placeholder="Rechercher un guide ou un article..."
        class="w-full bg-[#0D0028] border border-[rgba(124,58,237,0.25)] rounded-full px-5 py-2.5 text-sm text-[#F1F0F7] placeholder-[#6B6880] focus:outline-none focus:border-[#7C3AED] transition-colors" />
    </div>

    <div class="hidden mb-8 p-4 rounded-xl" id="guide-subcats" style="background:rgba(6,182,212,0.05);border:1px solid rgba(6,182,212,0.2);">
      <p class="text-[#06B6D4] text-xs font-semibold uppercase tracking-wide mb-3">Filtrer les guides par thème</p>
      <div class="flex flex-wrap gap-2">
        <button data-gcat="" class="gcat-btn px-3 py-1.5 rounded-full text-xs font-medium transition-all border bg-[#06B6D4] border-[#06B6D4] text-[#07001C]" aria-pressed="true">Tous les thèmes</button>
        {guideCats.map(g => (
          <button data-gcat={g.id} class="gcat-btn px-3 py-1.5 rounded-full text-xs font-medium transition-all border bg-transparent border-[rgba(6,182,212,0.3)] text-[#9B99AA] hover:border-[#06B6D4] hover:text-[#F1F0F7]" aria-pressed="false">{g.label}</button>
        ))}
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6" id="blog-grid">
      {ALL_ITEMS.map(a => (
        <a href={a.href} data-cat={a.cat} data-type={a.type} data-gcat={(a.gcat || []).join(' ')} data-q={(a.titre + ' ' + a.desc + ' ' + a.cat).toLowerCase()}
           class="article-card bg-[#0D0028] border border-[rgba(124,58,237,0.15)] rounded-xl p-6 hover:border-[#7C3AED] transition-all block group">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="bg-[#110833] border border-[rgba(124,58,237,0.3)] text-[#A78BFA] text-[10px] font-medium px-2 py-0.5 rounded-full">{a.cat}</span>
            {a.type === 'guide' && <span style="background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.35);color:#06B6D4;font-size:10px;font-weight:600;padding:1px 8px;border-radius:9999px;">Guide</span>}
            {a.date && <span class="text-[#9B99AA] text-xs">{a.date}</span>}
          </div>
          <h2 class="font-syne font-bold text-[#F1F0F7] text-sm leading-snug mb-2 group-hover:text-[#A78BFA] transition-colors">{a.titre}</h2>
          <p class="text-[#9B99AA] text-xs leading-relaxed">{a.desc}</p>
        </a>
      ))}
    </div>
    <p id="blog-empty" class="hidden text-center text-[#9B99AA] py-16">Aucune ressource dans cette catégorie.</p>
  </div>
</section>

<button id="back-to-top" title="Remonter en haut"
  style="position:fixed;bottom:2rem;right:2rem;z-index:50;width:44px;height:44px;border-radius:50%;background:#7C3AED;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(124,58,237,0.4);opacity:0;pointer-events:none;transition:opacity 0.25s,transform 0.25s;transform:translateY(8px);">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
  </svg>
</button>

<script>
const grid = document.getElementById('blog-grid');
const cards = Array.from(grid.querySelectorAll('.article-card'));
const countEl = document.getElementById('blog-count');
const emptyEl = document.getElementById('blog-empty');
const tabs = document.querySelectorAll('.tab-btn');
const searchInput = document.getElementById('blog-search');
const subcatsWrap = document.getElementById('guide-subcats');
const gcatBtns = document.querySelectorAll('.gcat-btn');

const state = { cats: [], types: [], gcat: '', search: '' };

function filterAndRender() {
  const q = state.search.trim().toLowerCase();
  let n = 0;
  cards.forEach(c => {
    const catOk = state.cats.length === 0 || state.cats.includes(c.dataset.cat);
    const typeOk = state.types.length === 0 || state.types.includes(c.dataset.type);
    const gcatOk = !state.gcat || c.dataset.gcat.split(' ').includes(state.gcat);
    const searchOk = !q || c.dataset.q.includes(q);
    const show = catOk && typeOk && gcatOk && searchOk;
    c.hidden = !show;
    if (show) n++;
  });
  countEl.textContent = `Blog & Guides · ${n} ressource${n > 1 ? 's' : ''}`;
  emptyEl.classList.toggle('hidden', n > 0);
}

// Onglets principaux
tabs.forEach(tab => {
  tab.addEventListener('click', () => {
    tabs.forEach(t => {
      t.classList.remove('bg-[#7C3AED]','border-[#7C3AED]','text-white');
      t.classList.add('bg-transparent','border-[rgba(124,58,237,0.3)]','text-[#9B99AA]');
      t.setAttribute('aria-selected','false');
    });
    tab.classList.add('bg-[#7C3AED]','border-[#7C3AED]','text-white');
    tab.classList.remove('bg-transparent','border-[rgba(124,58,237,0.3)]','text-[#9B99AA]');
    tab.setAttribute('aria-selected','true');
    state.cats = JSON.parse(tab.dataset.cats || '[]');
    state.types = JSON.parse(tab.dataset.types || '[]');
    state.gcat = '';
    const isGuides = tab.dataset.tab === 'guides';
    subcatsWrap.classList.toggle('hidden', !isGuides);
    if (isGuides) {
      gcatBtns.forEach((b, i) => {
        b.classList.toggle('bg-[#06B6D4]', i === 0);
        b.classList.toggle('border-[#06B6D4]', i === 0);
        b.classList.toggle('text-[#07001C]', i === 0);
        b.classList.toggle('bg-transparent', i !== 0);
        b.classList.toggle('border-[rgba(6,182,212,0.3)]', i !== 0);
        b.classList.toggle('text-[#9B99AA]', i !== 0);
        b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
      });
    }
    filterAndRender();
  });
});

// Sous-catégories de guides
gcatBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    gcatBtns.forEach(b => {
      b.classList.remove('bg-[#06B6D4]','border-[#06B6D4]','text-[#07001C]');
      b.classList.add('bg-transparent','border-[rgba(6,182,212,0.3)]','text-[#9B99AA]');
      b.setAttribute('aria-pressed','false');
    });
    btn.classList.add('bg-[#06B6D4]','border-[#06B6D4]','text-[#07001C]');
    btn.classList.remove('bg-transparent','border-[rgba(6,182,212,0.3)]','text-[#9B99AA]');
    btn.setAttribute('aria-pressed','true');
    state.gcat = btn.dataset.gcat || '';
    filterAndRender();
  });
});

// Recherche
searchInput.addEventListener('input', () => {
  state.search = searchInput.value;
  filterAndRender();
});

// Activer onglet depuis URL ?tab=
const urlTab = new URLSearchParams(window.location.search).get('tab');
if (urlTab) {
  const target = document.querySelector('.tab-btn[data-tab="' + urlTab + '"]');
  if (target) target.click();
} else {
  filterAndRender();
}

// Bouton retour en haut
const btn = document.getElementById('back-to-top');
window.addEventListener('scroll', () => {
  const show = window.scrollY > 400;
  btn.style.opacity = show ? '1' : '0';
  btn.style.pointerEvents = show ? 'auto' : 'none';
  btn.style.transform = show ? 'translateY(0)' : 'translateY(8px)';
}, { passive: true });
btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
<style is:global>.article-card[hidden]{display:none!important}</style>
</Layout>
