<div id="guide-wrapper">
<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  :root{--rouge:#dc3545;--rouge-fonce:#6f1520;--bleu:#004080;--gris:#2c3e50}
  body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:#e9ecef;display:flex;justify-content:center;padding:24px;color:#1d2228}
  .toolbar{display:flex;flex-direction:column;gap:10px}
  .toolbar button{width:100%;background:linear-gradient(135deg,var(--rouge),var(--rouge-fonce));color:#fff;border:none;padding:12px 22px;border-radius:25px;font-size:.95em;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.25)}
  .toolbar button:hover{transform:translateY(-2px)}
  .toolbar .btn-pdf{background:linear-gradient(135deg,#0088cc,#004080)}
  .toolbar .btn-dl{display:flex;justify-content:center;width:100%;align-items:center;gap:8px;text-decoration:none;color:#fff;padding:12px 22px;border-radius:25px;font-size:.95em;font-weight:700;box-shadow:0 4px 14px rgba(0,0,0,.25);background:linear-gradient(135deg,#198754,#0f5132);transition:transform .15s}
  .toolbar .btn-dl:hover{transform:translateY(-2px)}
  .toolbar .btn-dl .sz{font-weight:600;font-size:.82em;opacity:.8}
  .back-fixed{position:fixed;top:16px;left:16px;z-index:10;display:inline-flex;align-items:center;gap:8px;padding:12px 22px;background:#fff;color:var(--rouge-fonce);text-decoration:none;border-radius:25px;font-size:.95em;font-weight:700;box-shadow:0 4px 14px rgba(0,0,0,.25);transition:transform .15s}
  .back-fixed:hover{transform:translateY(-2px)}

  .modal-overlay{position:fixed;inset:0;background:rgba(20,24,28,.62);display:none;align-items:center;justify-content:center;z-index:30;padding:20px}
  .modal-overlay.show{display:flex}
  .modal{background:#fff;max-width:500px;width:100%;border-radius:14px;overflow:hidden;box-shadow:0 22px 60px rgba(0,0,0,.4)}
  .modal-head{background:linear-gradient(135deg,var(--rouge),var(--rouge-fonce));color:#fff;padding:16px 22px;display:flex;justify-content:space-between;align-items:center}
  .modal-head h2{font-size:1.18em;margin:0}
  .modal-head .x{background:none;border:none;color:#fff;font-size:1.6em;line-height:1;cursor:pointer}
  .modal-body{padding:18px 24px 6px;color:#333;line-height:1.55;font-size:.98em}
  .modal-body ol{margin:0 0 6px 20px}
  .modal-body li{margin-bottom:9px}
  .modal-body b{color:var(--rouge-fonce)}
  .modal-foot{padding:14px 24px 22px;display:flex;gap:10px;justify-content:flex-end}
  .modal-foot button{border:none;border-radius:22px;padding:11px 22px;font-weight:700;cursor:pointer;font-size:.95em}
  .btn-go{background:linear-gradient(135deg,var(--rouge),var(--rouge-fonce));color:#fff}
  .btn-cancel{background:#e9ecef;color:#444}

  .page{width:100%;max-width:210mm;min-height:297mm;background:#fff;box-shadow:0 10px 40px rgba(0,0,0,.18);display:flex;flex-direction:column;overflow:hidden}

  .poster-header{background:linear-gradient(135deg,var(--rouge),var(--rouge-fonce));color:#fff;padding:14mm 14mm 11mm;position:relative}
  .poster-header::after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;background:linear-gradient(90deg,#ffc107,#fff3 60%,transparent)}
  .brand{display:flex;align-items:center;gap:12px;margin-bottom:10mm}
  .brand img{filter:brightness(0) invert(1)}
  .brand .tag{font-size:.95em;opacity:.92;border-left:1px solid rgba(255,255,255,.4);padding-left:12px}
  .poster-header .eyebrow{font-size:1em;letter-spacing:.28em;text-transform:uppercase;opacity:.9;font-weight:600}
  .poster-header h2{font-size:3.4em;line-height:1.02;margin:6px 0 8px;font-weight:800}
  .poster-header .sub{font-size:1.35em;opacity:.95}

  .grid{flex:1;display:grid;grid-template-columns:1fr 1fr;gap:5mm 8mm;padding:11mm 14mm 6mm}
  .reflex{display:flex;align-items:flex-start;gap:11px}
  .num{flex-shrink:0;width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--rouge),var(--rouge-fonce));color:#fff;font-weight:800;font-size:1.05em;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 8px rgba(220,53,69,.3)}
  .reflex .txt{padding-top:2px;font-size:1.06em;line-height:1.32}
  .reflex .txt b{color:var(--rouge-fonce)}
  .ico{font-size:1.15em;margin-right:3px}

  .accent{grid-column:1 / -1;background:#fff3cd;border-left:5px solid #ffc107;border-radius:0 8px 8px 0;padding:9px 16px;font-size:1.04em;color:#5b4a08;display:flex;align-items:center;gap:10px}
  .accent .big{font-size:1.5em}

  .poster-footer{background:linear-gradient(135deg,var(--gris),#34495e);color:#fff;padding:8mm 14mm;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
  .poster-footer .doubt{font-size:1.18em;font-weight:700;line-height:1.3}
  .poster-footer .doubt span{display:block;font-weight:400;font-size:.78em;opacity:.85;margin-top:3px}
  .contact{text-align:right;line-height:1.5}
  .contact .phone{font-size:1.55em;font-weight:800;color:#fff}
  .contact .site{font-size:.95em;color:#bdc3c7}
  .contact .place{font-size:.85em;color:#9fb0bf}


  .affiche-layout{display:flex;gap:2rem;align-items:flex-start;justify-content:center;flex-wrap:wrap;padding:2rem 1rem;background:#e9ecef}
  .affiche-side{flex:0 0 300px;position:sticky;top:6rem;display:flex;flex-direction:column;gap:1rem}
  .side-card{background:#fff;border-radius:14px;padding:1rem;box-shadow:0 4px 14px rgba(0,0,0,.12)}
  .side-card h2{font-size:.8rem;text-transform:none;letter-spacing:.04em;color:#6f1520;font-weight:800;margin-bottom:.6rem}
  .side-thumb{display:block;width:100%;height:auto;border-radius:8px;margin-bottom:.8rem}
  .side-links{list-style:none;display:flex;flex-direction:column;gap:.5rem;font-size:.92rem}
  .side-links a{color:#004080;text-decoration:none;font-weight:600}
  .side-links a:hover{text-decoration:underline}
  @media(max-width:1100px){.affiche-side{position:static;flex-basis:100%;max-width:210mm;order:-1}}
  @media print{
    @page{size:A4;margin:0}
    body{background:#fff;padding:0}
    .affiche-side,.modal-overlay,.back-fixed{display:none !important}
    .affiche-layout{display:block;padding:0;background:#fff}.page{box-shadow:none;width:auto;max-width:none;min-height:auto}
  }
</style>


