---
// Hub des guides : une page d'entrée crawlable, organisée par parcours. Les guides d'exploitation internes (noindex) en sont exclus.
import Layout from '../../layouts/Layout.astro';
import { ALL_ITEMS } from '../../data/blog-items.js';
import { NOINDEX_PATHS } from '../../data/noindex-paths.js';

const guides = ALL_ITEMS.filter((x) => x.type === 'guide' && !NOINDEX_PATHS.has(x.href));
const par = (href) => ALL_ITEMS.find((x) => x.href === href);

// Pages qui ne sont pas des guides mais complètent un parcours
const EXTRA = {
  ia: [{ href: '/blog/ia-la-reunion-pme-questions-de-base/', cat: 'Article', titre: "L'IA en entreprise à La Réunion : les questions de base", desc: "À quoi sert l'IA dans une petite entreprise, combien ça coûte, que faire de vos données et par où commencer." }],
  erp: [{ href: '/facture-electronique/', cat: 'Réglementation', titre: 'Facture électronique 2026-2027 : que doit faire une TPE ou PME ?', desc: 'Les dates à retenir, les plateformes agréées, les formats et les étapes pour se préparer.' }],
};

const PARCOURS = [
  { id: 'cyber', titre: 'Cybersécurité et e-mails', intro: 'Protéger vos comptes, vos e-mails et vos données au quotidien.', gcat: ['securite', 'forensique'] },
  { id: 'm365', titre: 'Microsoft 365, postes de travail et messagerie', intro: "Prendre en main vos outils de travail et récupérer un fichier perdu.", gcat: ['messagerie', 'poste', 'cloud'] },
  { id: 'ia', titre: 'Intelligence artificielle', intro: "Utiliser l'IA en entreprise, sans risque pour vos données.", gcat: ['ia'] },
  { id: 'erp', titre: 'ERP, Dolibarr et facturation électronique', intro: 'Gérer votre activité et préparer la facturation électronique.', gcat: ['erp'] },
  { id: 'infra', titre: 'Infogérance, outils et site web', intro: 'Les outils et méthodes de notre quotidien, à votre disposition.', gcat: ['infogerance', 'outils', 'webmestre'] },
];
const rangees = new Set();
const sections = PARCOURS.map((p) => {
  const items = guides.filter((g) => !rangees.has(g.href) && (g.gcat ?? []).some((c) => p.gcat.includes(c)));
  items.forEach((g) => rangees.add(g.href));
  return { ...p, items: [...(EXTRA[p.id] ?? []), ...items] };
});
const autres = guides.filter((g) => !rangees.has(g.href));
if (autres.length) sections.push({ id: 'autres', titre: 'Autres guides', intro: '', items: autres });

const UNE = [
  '/guides/guide-mfa-microsoft-authenticator/', '/guides/affiche-13-reflexes-cybersecurite/', '/guides/guide-ia-pour-pme/',
  '/guides/guide-restauration-fichiers/', '/guides/outil-autoevaluation-securite-cnil/', '/guides/guide-facture-electronique-dolibarr/',
].map(par).filter(Boolean);

const tous = sections.flatMap((s) => s.items);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guides pratiques pour TPE et PME à La Réunion',
  url: 'https://gigarun.re/guides/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: tous.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: 'https://gigarun.re' + g.href, name: g.titre })),
  },
};
const diagnostic = 'https://cybersecure.re/?utm_source=gigarun&utm_medium=hub-guides&utm_campaign=diagnostic';
---
<Layout title="Guides pratiques pour TPE et PME à La Réunion — Gigarun" description="Guides pas à pas gratuits : cybersécurité, Microsoft 365, sauvegarde, intelligence artificielle, facturation électronique, Dolibarr. Par GiGaRuN, La Réunion.">
<section class="bg-[#07001C] pt-32 pb-12">
  <div class="max-w-6xl mx-auto px-6">
    <p class="text-[#A78BFA] text-sm font-medium mb-3">Guides pratiques</p>
    <h1 class="font-syne font-extrabold text-[#F1F0F7] mb-5" style="font-size:clamp(30px,5vw,52px);line-height:1.1;">Guides pratiques pour votre entreprise</h1>
    <p class="text-[#9B99AA] text-lg max-w-2xl mb-8">Des explications pas à pas, écrites par nos techniciens, pour sécuriser vos comptes, maîtriser vos outils, utiliser l'IA et préparer la facturation électronique.</p>
    <div class="flex flex-wrap gap-3">
      <a href={diagnostic} rel="noopener" class="bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-medium px-6 py-3 rounded-full transition-colors">Tester mon domaine gratuitement</a>
      <a href="/contact/" class="border border-[rgba(124,58,237,0.5)] text-[#A78BFA] hover:bg-[rgba(124,58,237,0.15)] font-medium px-6 py-3 rounded-full transition-colors">Poser une question</a>
    </div>
  </div>
</section>
{UNE.length > 0 && (
  <section class="bg-[#0A0022] py-14">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-syne font-bold text-[#F1F0F7] mb-6" style="font-size:1.5rem;">À lire en premier</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {UNE.map((g) => (
          <a href={g.href} class="block bg-[#0D0028] border border-[rgba(124,58,237,0.25)] hover:border-[#7C3AED] rounded-xl p-5 transition-colors">
            <span class="text-[#A78BFA] text-[11px] font-medium">{g.cat}</span>
            <h3 class="text-white font-semibold mt-1 mb-2 leading-snug">{g.titre}</h3>
            <p class="text-[#9B99AA] text-sm leading-relaxed line-clamp-3">{g.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
{sections.filter((s) => s.items.length).map((s, i) => (
  <section class={i % 2 === 0 ? 'bg-[#07001C] py-14' : 'bg-[#0A0022] py-14'} id={s.id}>
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-syne font-bold text-[#F1F0F7] mb-2" style="font-size:1.5rem;">{s.titre}</h2>
      {s.intro && <p class="text-[#9B99AA] text-sm mb-6 max-w-2xl">{s.intro}</p>}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {s.items.map((g) => (
          <a href={g.href} class="block bg-[#0D0028] border border-[rgba(124,58,237,0.15)] hover:border-[#7C3AED] rounded-xl p-5 transition-colors">
            <span class="text-[#A78BFA] text-[11px] font-medium">{g.cat}</span>
            <h3 class="text-white font-semibold mt-1 mb-2 leading-snug">{g.titre}</h3>
            <p class="text-[#9B99AA] text-sm leading-relaxed line-clamp-3">{g.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
))}
<section class="bg-[#0A0022] py-16">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="font-syne font-bold text-[#F1F0F7] mb-3" style="font-size:1.5rem;">Un besoin précis ?</h2>
    <p class="text-[#9B99AA] text-sm mb-6">Ces guides ne remplacent pas un accompagnement : si votre situation est particulière, écrivez-nous, nous vous répondons par écrit.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/contact/" class="bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-medium px-6 py-3 rounded-full transition-colors">Nous écrire</a>
      <a href="/blog/" class="border border-[rgba(124,58,237,0.5)] text-[#A78BFA] hover:bg-[rgba(124,58,237,0.15)] font-medium px-6 py-3 rounded-full transition-colors">Lire nos articles</a>
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
</section>
</Layout>
