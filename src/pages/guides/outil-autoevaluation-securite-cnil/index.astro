---
import Layout from '../../../layouts/Layout.astro';
import { FORMS_WEBHOOK } from '../../../config';
---
<Layout title="Auto-évaluation Sécurité des Données — Référentiel CNIL" description="Outil d’auto-évaluation de la sécurité des données personnelles selon les 25 mesures du guide CNIL : statut, commentaires, score et export.">
<script type="application/ld+json" is:inline>{"@context": "https://schema.org", "@type": "TechArticle", "headline": "Auto-évaluation Sécurité des Données — Référentiel CNIL", "image": "https://gigarun.re/images/og-default.png", "description": "Outil d’auto-évaluation de la sécurité des données personnelles selon les 25 mesures du guide CNIL : statut, commentaires, score et export.", "author": {"@type": "Person", "name": "Thomas Cassen", "jobTitle": "DSI externalise & expert cybersecurite", "sameAs": "https://re.linkedin.com/in/thomascassen"}, "publisher": {"@type": "Organization", "name": "Gigarun", "logo": {"@type": "ImageObject", "url": "https://gigarun.re/favicon.ico"}}, "mainEntityOfPage": "https://gigarun.re/guides/outil-autoevaluation-securite-cnil", "datePublished": "2026-06-04T00:00:00+04:00", "dateModified": "2026-06-04T00:00:00+04:00"}</script>
<div class="guide-hero-dark" style="background:#07001C;padding-top:8rem;padding-bottom:2rem;">
  <div style="max-width:56rem;margin:0 auto;padding:0 1.5rem;text-align:center;">
    <div class="flex items-center gap-3 mb-3" style="justify-content:center;">
      <a href="/guides/" class="text-[#9B99AA] hover:text-[#A78BFA] text-sm transition-colors">← Guides pratiques</a>
    </div>
    <div class="flex items-center gap-2 mb-2" style="justify-content:center;">
      <span class="bg-[#110833] border border-[rgba(124,58,237,0.3)] text-[#A78BFA] text-[11px] font-medium px-3 py-1 rounded-full">Guide pratique · Sécurité</span>
    </div>
    <h1 class="font-syne font-extrabold text-[#F1F0F7] leading-tight text-center" style="font-size:clamp(24px,3.5vw,40px);text-align:center;">Auto-évaluation Sécurité des Données — Référentiel CNIL</h1>
    <p class="text-[#9B99AA] text-sm mt-2 mb-0" style="text-align:center;">Outil d&#x27;auto-évaluation de la sécurité des données personnelles basé sur les 25 mesures du guide CNIL. Statut de conformité, commentaires, score et export par GiGaRuN.</p>
  </div>
</div>


<div id="guide-wrapper">
<style is:global>
#guide-wrapper{background:#fff;color:#333;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;line-height:1.6}
#cnil{--bleu:#0088cc;--bleu-fonce:#004080;--hero1:#1a5276;--hero2:#2e86c1;--vert:#198754;--ambre:#f59e0b;--rouge:#dc3545;--gris:#6c757d;max-width:820px;margin:0 auto;padding:28px 16px 60px}
#cnil *{box-sizing:border-box}
#cnil .card{background:#fff;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.08);padding:20px 22px;margin-bottom:16px;border:1px solid #eef1f4}
#cnil .card h2{font-size:1.1em;color:var(--hero1);margin:0 0 14px;padding-bottom:8px;border-bottom:2px solid var(--hero2)}
#cnil .intro{font-size:.95em;color:#555;margin-bottom:16px}
#cnil .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
#cnil .field label{display:block;font-size:.85em;font-weight:600;color:#555;margin-bottom:5px}
#cnil .field input{width:100%;padding:10px 12px;border:1px solid #ced4da;border-radius:8px;font-size:.95em;font-family:inherit;color:#222;background:#fff}
#cnil input:focus,#cnil textarea:focus{outline:none;border-color:var(--hero2);box-shadow:0 0 0 3px rgba(46,134,193,.15)}
#cnil .progress{position:sticky;top:0;z-index:5;background:#fff;padding:10px 0 12px;margin-bottom:8px}
#cnil .progress-txt{font-size:.85em;font-weight:600;color:var(--hero1);margin-bottom:6px;display:flex;justify-content:space-between}
#cnil .bar{height:8px;background:#e9ecef;border-radius:8px;overflow:hidden}
#cnil .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--bleu),var(--vert));transition:width .3s}
#cnil .fiche{background:#fff;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:12px;border:1px solid #eef1f4;border-left:5px solid #dee2e6;overflow:hidden}
#cnil .fiche.s-conforme{border-left-color:var(--vert)}#cnil .fiche.s-partiel{border-left-color:var(--ambre)}#cnil .fiche.s-non{border-left-color:var(--rouge)}#cnil .fiche.s-na{border-left-color:var(--gris)}
#cnil .fiche.new{animation:cnilIn .35s ease}
@keyframes cnilIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
#cnil .fiche-head{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;width:100%;background:none;border:0;text-align:left;font:inherit;color:inherit}
#cnil .fiche-num{flex-shrink:0;width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--bleu),var(--bleu-fonce));color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:.95em}
#cnil .fiche-txt{flex:1;min-width:0}
#cnil .fiche-cat{display:block;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:#888}
#cnil .fiche-txt h3{font-size:1.02em;color:#222;margin:0}
#cnil .badge{font-size:.78em;font-weight:700;color:#fff;border-radius:12px;padding:3px 10px;white-space:nowrap}
#cnil .badge.conforme{background:var(--vert)}#cnil .badge.partiel{background:var(--ambre)}#cnil .badge.non{background:var(--rouge)}#cnil .badge.na{background:var(--gris)}
#cnil .fiche-body{display:none;padding:0 16px 16px 62px}
#cnil .fiche.open .fiche-body{display:block}
#cnil .fiche-body p{font-size:.92em;color:#555;margin:0 0 12px}
#cnil .seg{display:flex;flex-wrap:wrap;gap:8px}
#cnil .seg button{border:2px solid #dee2e6;background:#fff;color:#555;border-radius:20px;padding:7px 16px;font-size:.88em;font-weight:600;cursor:pointer;font-family:inherit}
#cnil .seg button:hover{border-color:#adb5bd}
#cnil .seg button.on[data-v="conforme"]{background:var(--vert);border-color:var(--vert);color:#fff}
#cnil .seg button.on[data-v="partiel"]{background:var(--ambre);border-color:var(--ambre);color:#fff}
#cnil .seg button.on[data-v="non"]{background:var(--rouge);border-color:var(--rouge);color:#fff}
#cnil .seg button.on[data-v="na"]{background:var(--gris);border-color:var(--gris);color:#fff}
#cnil textarea{width:100%;margin-top:12px;padding:9px 12px;border:1px solid #ced4da;border-radius:8px;font-family:inherit;font-size:.9em;resize:vertical;min-height:44px;color:#222;background:#fff}
#cnil .score-top{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-bottom:16px}
#cnil .score-ring{flex-shrink:0;width:112px;height:112px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e9ecef}
#cnil .score-ring .inner{width:86px;height:86px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center}
#cnil .score-ring .pct{font-size:1.7em;font-weight:800;line-height:1}
#cnil .score-ring .lbl{font-size:.6em;color:#888;text-transform:uppercase;letter-spacing:.05em;margin-top:2px}
#cnil .score-note{font-size:.92em;color:#555;flex:1;min-width:200px}
#cnil .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px}
#cnil .kpi{border-radius:10px;padding:12px;text-align:center;color:#fff}
#cnil .kpi b{font-size:1.5em;display:block}#cnil .kpi span{font-size:.78em}
#cnil .kpi.c{background:var(--vert)}#cnil .kpi.p{background:var(--ambre)}#cnil .kpi.n{background:var(--rouge)}#cnil .kpi.na{background:var(--gris)}
#cnil .consent{display:flex;gap:10px;align-items:flex-start;background:#f8f9fa;border:1px solid #dee2e6;border-radius:10px;padding:12px 14px;margin:16px 0;font-size:.88em;color:#444;cursor:pointer}
#cnil .consent input{margin-top:3px;width:18px;height:18px;flex-shrink:0;cursor:pointer}
#cnil .consent a{color:var(--bleu-fonce);text-decoration:underline}
#cnil .btn{border:none;border-radius:24px;padding:11px 22px;font-weight:700;font-size:.92em;cursor:pointer;color:#fff;font-family:inherit;background:linear-gradient(135deg,var(--bleu),var(--bleu-fonce))}
#cnil .btn:disabled{opacity:.45;cursor:not-allowed}
#cnil .btn-send{background:linear-gradient(135deg,#198754,#20c997);font-size:1rem;padding:13px 28px}
#cnil .btn-link{background:none;border:0;color:#6c757d;text-decoration:underline;cursor:pointer;font:inherit;font-size:.85em;padding:4px 0}
#cnil .msg{margin-top:12px;font-size:.92em;font-weight:600}
#cnil .msg.err{color:var(--rouge)}#cnil .msg.ok{color:var(--vert)}
#cnil .hp{position:absolute;left:-9999px;height:0;overflow:hidden}
#cnil .disclaimer{background:#fff3cd;border-left:5px solid var(--ambre);border-radius:0 10px 10px 0;padding:14px 18px;font-size:.88em;color:#5b4a08;margin-top:18px}
#cnil .tools{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px}
@media(max-width:600px){#cnil .fiche-body{padding-left:16px}}
@media print{#cnil .progress,#cnil .tools,#cnil .consent,#cnil .btn-send,#cnil .seg button:not(.on){display:none}#cnil .fiche-body{display:block}}
</style>

<div id="cnil">
  <p class="intro">Évaluez la protection des données personnelles de votre organisme face aux 25 mesures du <strong>Guide de la sécurité des données personnelles de la CNIL</strong>. Répondez mesure par mesure : la suivante s'affiche au fur et à mesure. À la fin, vous obtenez votre score et pouvez nous envoyer l'évaluation.</p>

  <div class="card">
    <h2>Votre organisme</h2>
    <div class="grid">
      <div class="field"><label for="m-org">Organisme évalué</label><input id="m-org" type="text" autocomplete="organization" placeholder="Nom de l'entreprise / organisation"></div>
      <div class="field"><label for="m-nom">Votre nom</label><input id="m-nom" type="text" autocomplete="name" placeholder="Prénom Nom"></div>
      <div class="field"><label for="m-email">Votre e-mail</label><input id="m-email" type="email" autocomplete="email" placeholder="vous@entreprise.re"></div>
    </div>
  </div>

  <div class="progress">
    <div class="progress-txt"><span id="progTxt"></span><button type="button" class="btn-link" id="btnReset">Recommencer</button></div>
    <div class="bar"><i id="progBar"></i></div>
  </div>

  <div id="fiches"></div>

  <div id="final" class="card" style="display:none">
    <h2>Votre synthèse</h2>
    <div class="score-top">
      <div class="score-ring" id="ring"><div class="inner"><span class="pct" id="pct">0%</span><span class="lbl">conformité</span></div></div>
      <div class="score-note">Taux calculé sur les mesures évaluées (hors « Non applicable ») : Conforme = 100&nbsp;%, Partiel = 50&nbsp;%.</div>
    </div>
    <div class="kpis">
      <div class="kpi c"><b id="k-c">0</b><span>Conforme</span></div>
      <div class="kpi p"><b id="k-p">0</b><span>Partiel</span></div>
      <div class="kpi n"><b id="k-n">0</b><span>Non conforme</span></div>
      <div class="kpi na"><b id="k-na">0</b><span>Non applicable</span></div>
    </div>

    <form id="sendForm" novalidate>
      <div class="hp" aria-hidden="true"><label>Ne pas remplir <input type="text" id="hp" tabindex="-1" autocomplete="off"></label></div>
      <label class="consent" for="rgpd">
        <input type="checkbox" id="rgpd" required>
        <span>J'accepte que mes coordonnées et mes réponses soient traitées par GiGaRuN afin de me transmettre l'analyse de cette évaluation, conformément à la <a href="/confidentialite/" target="_blank" rel="noopener">politique de confidentialité</a>. Aucune donnée n'est transmise à des tiers.</span>
      </label>
      <button type="submit" class="btn btn-send" id="btnSend">Envoyer mon évaluation →</button>
      <div class="msg" id="sendMsg" role="status"></div>
    </form>

    <div class="tools">
      <button type="button" class="btn-link" id="btnExport">Exporter (JSON)</button>
      <button type="button" class="btn-link" id="btnImport">Importer</button>
      <input type="file" id="importFile" accept="application/json" style="display:none">
      <button type="button" class="btn-link" id="btnPrint">Imprimer / PDF</button>
    </div>
  </div>

  <div class="disclaimer">
    <strong>Avertissement :</strong> cet outil est une aide à l'auto-évaluation inspirée du référentiel CNIL. Il ne constitue ni un audit certifié, ni une attestation de conformité au RGPD. Les résultats doivent être interprétés et complétés par une analyse de risques (fiche&nbsp;20) menée avec votre DPO / RSSI.
  </div>
</div>

<script define:vars={{ webhook: FORMS_WEBHOOK }}>
const FICHES = [
  {n:1,  c:"Gouvernance & organisation", t:"Piloter la sécurité des données", o:"Mettre en place et maintenir dans la durée la protection exigée par le RGPD et les cadres sectoriels."},
  {n:2,  c:"Gouvernance & organisation", t:"Définir un cadre pour les utilisateurs", o:"Donner une force contraignante aux règles d'usage des outils (charte informatique)."},
  {n:3,  c:"Gouvernance & organisation", t:"Impliquer et former les utilisateurs", o:"Sensibiliser chaque utilisateur aux enjeux de sécurité et de vie privée."},
  {n:14, c:"Gouvernance & organisation", t:"Gérer la sous-traitance", o:"Encadrer contractuellement la sécurité des données chez les sous-traitants (art. 28)."},
  {n:20, c:"Gouvernance & organisation", t:"Analyse de risques", o:"Identifier les risques, évaluer vraisemblance et gravité, choisir des mesures adaptées."},

  {n:4,  c:"Authentification & accès", t:"Authentifier les utilisateurs", o:"Reconnaître les utilisateurs avant d'accorder les accès (mots de passe robustes, MFA)."},
  {n:5,  c:"Authentification & accès", t:"Gérer les habilitations", o:"Limiter les accès aux seules données nécessaires (moindre privilège, revues régulières)."},

  {n:6,  c:"Postes de travail & mobilité", t:"Sécuriser les postes de travail", o:"Prévenir accès frauduleux, programmes malveillants et prise de contrôle à distance."},
  {n:7,  c:"Postes de travail & mobilité", t:"Sécuriser l'informatique mobile", o:"Anticiper la perte ou le vol et la fuite hors des locaux (chiffrement, MDM)."},

  {n:8,  c:"Infrastructure & réseau", t:"Protéger le réseau informatique", o:"N'autoriser que les flux nécessaires (cloisonnement, pare-feu, filtrage)."},
  {n:9,  c:"Infrastructure & réseau", t:"Sécuriser les serveurs", o:"Durcir la configuration et restreindre les accès aux serveurs."},
  {n:10, c:"Infrastructure & réseau", t:"Sécuriser les sites web", o:"Appliquer les bonnes pratiques minimales (HTTPS, en-têtes, mises à jour)."},
  {n:12, c:"Infrastructure & réseau", t:"Protéger les locaux", o:"Renforcer la sécurité physique des locaux hébergeant serveurs et matériels réseau."},
  {n:15, c:"Infrastructure & réseau", t:"Encadrer la maintenance et la fin de vie", o:"Garantir la sécurité des données sur tout le cycle de vie matériel et logiciel (effacement sécurisé)."},

  {n:13, c:"Données, échanges & traçabilité", t:"Sécuriser les échanges avec l'extérieur", o:"Sécuriser toute transmission de données (chiffrement, canaux protégés)."},
  {n:16, c:"Données, échanges & traçabilité", t:"Tracer les opérations", o:"Journaliser pour détecter anomalies et incidents et disposer des éléments d'investigation."},
  {n:21, c:"Données, échanges & traçabilité", t:"Chiffrement, hachage, signature", o:"Assurer intégrité, confidentialité et authenticité des informations."},

  {n:17, c:"Résilience", t:"Sauvegarder", o:"Réaliser des sauvegardes régulières et testées pour limiter l'impact d'une perte ou altération."},
  {n:18, c:"Résilience", t:"Prévoir la continuité et la reprise d'activité", o:"Fonctionner en mode dégradé et redémarrer sans compromettre la sécurité des données (PCA/PRA)."},
  {n:19, c:"Résilience", t:"Gérer les incidents et les violations", o:"Procédures de gestion d'incident + notification CNIL sous 72 h en cas de violation."},

  {n:11, c:"Domaines spécifiques", t:"Encadrer les développements informatiques", o:"Intégrer sécurité et protection des données au plus tôt (privacy by design)."},
  {n:22, c:"Domaines spécifiques", t:"Cloud : informatique en nuage", o:"Sécuriser données et traitements dans le cloud (responsabilités partagées, localisation)."},
  {n:23, c:"Domaines spécifiques", t:"Applications mobiles : conception", o:"Appliquer les principes de sécurité de base au développement d'applications mobiles."},
  {n:24, c:"Domaines spécifiques", t:"Intelligence artificielle : conception", o:"Se doter des ressources pour des systèmes d'IA robustes, fiables et conformes."},
  {n:25, c:"Domaines spécifiques", t:"API : interfaces de programmation", o:"Sécuriser les données partagées via API (authentification, contrôle d'accès, quotas)."}
];
const LABELS = {conforme:"Conforme", partiel:"Partiel", non:"Non conforme", na:"Non applicable"};
const KEY = "gigarun-cnil-audit-v2";
const $ = id => document.getElementById(id);
const EMPTY = () => ({meta:{org:"",nom:"",email:""}, items:{}, open:null});
const FIELDS = [["org","m-org"],["nom","m-nom"],["email","m-email"]];
let state = EMPTY();

function load(){ try{const s=JSON.parse(localStorage.getItem(KEY)); if(s&&s.items) state=Object.assign(EMPTY(),s);}catch(e){} }
function save(){ try{localStorage.setItem(KEY, JSON.stringify(state));}catch(e){} }
const esc = s => String(s).replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const statusOf = n => (state.items[n]||{}).status;
// index de la première mesure sans statut (FICHES.length si tout est répondu)
const firstTodo = () => { const i=FICHES.findIndex(f=>!statusOf(f.n)); return i<0?FICHES.length:i; };
const fillMeta = () => FIELDS.forEach(([k,id])=>{ $(id).value=state.meta[k]||""; });

function render(scrollTo){
  const todo=firstTodo(), root=$('fiches');
  const open = state.open!=null ? state.open : (todo<FICHES.length?FICHES[todo].n:null);
  root.innerHTML = FICHES.slice(0, Math.min(todo+1, FICHES.length)).map(f=>{
    const it=state.items[f.n]||{}, s=it.status, isOpen=f.n===open;
    const segs=["conforme","partiel","non","na"].map(v=>'<button type="button" data-v="'+v+'" class="'+(s===v?"on":"")+'">'+LABELS[v]+'</button>').join("");
    return '<div class="fiche'+(s?" s-"+s:"")+(isOpen?" open":"")+(scrollTo===f.n?" new":"")+'" id="fiche-'+f.n+'" data-n="'+f.n+'">'+
      '<button type="button" class="fiche-head" data-toggle="1"><span class="fiche-num">'+f.n+'</span>'+
      '<span class="fiche-txt"><span class="fiche-cat">'+esc(f.c)+'</span><h3>'+esc(f.t)+'</h3></span>'+
      (s?'<span class="badge '+s+'">'+LABELS[s]+'</span>':'')+'</button>'+
      '<div class="fiche-body"><p>'+esc(f.o)+'</p><div class="seg">'+segs+'</div>'+
      '<textarea placeholder="Commentaire, écart constaté, action corrective (facultatif)">'+esc(it.comment||"")+'</textarea></div></div>';
  }).join("");
  recompute();
  if(scrollTo!=null){ const el=$('fiche-'+scrollTo); if(el) el.scrollIntoView({behavior:'smooth',block:'center'}); }
}

function recompute(){
  let c=0,p=0,nn=0,na=0;
  FICHES.forEach(f=>{const s=statusOf(f.n); if(s==="conforme")c++; else if(s==="partiel")p++; else if(s==="non")nn++; else if(s==="na")na++;});
  const done=c+p+nn+na, ev=c+p+nn, pct=ev?Math.round((c+0.5*p)/ev*100):0;
  $('progTxt').textContent = done<FICHES.length ? "Mesure "+(done+1)+" sur "+FICHES.length : "Évaluation terminée";
  $('progBar').style.width = (done/FICHES.length*100)+"%";
  $('final').style.display = done===FICHES.length ? "block" : "none";
  [c,p,nn,na].forEach((v,i)=>{ $('k-'+["c","p","n","na"][i]).textContent=v; });
  const col = pct>=80?"#198754":(pct>=50?"#f59e0b":"#dc3545");
  $('pct').textContent=pct+"%"; $('pct').style.color=col;
  $('ring').style.background="conic-gradient("+col+" "+(pct*3.6)+"deg,#e9ecef "+(pct*3.6)+"deg)";
  return pct;
}

$('fiches').addEventListener('click', e=>{
  const card=e.target.closest('.fiche'); if(!card) return;
  const n=+card.dataset.n, btn=e.target.closest('.seg button');
  if(btn){
    const v=btn.dataset.v, it=state.items[n]||(state.items[n]={});
    it.status = it.status===v ? null : v;
    save();
    const todo=firstTodo();
    if(it.status && todo<FICHES.length){ state.open=FICHES[todo].n; render(state.open); }       // réponse -> mesure suivante
    else if(it.status){ state.open=-1; render(); $('final').scrollIntoView({behavior:'smooth',block:'start'}); } // dernière mesure
    else { state.open=n; render(); }                                                              // décochée -> on reste dessus
  } else if(e.target.closest('[data-toggle]')){
    state.open = card.classList.contains('open') ? -1 : n;
    render();
  }
});
$('fiches').addEventListener('input', e=>{
  if(e.target.tagName!=="TEXTAREA") return;
  const n=+e.target.closest('.fiche').dataset.n;
  (state.items[n]||(state.items[n]={})).comment=e.target.value; save();
});
FIELDS.forEach(([k,id])=>$(id).addEventListener('input',e=>{ state.meta[k]=e.target.value; save(); }));

function summary(pct){
  const l=["Auto-évaluation sécurité CNIL — score "+pct+" %","Organisme : "+state.meta.org,"Nom : "+state.meta.nom,"E-mail : "+state.meta.email,""];
  FICHES.forEach(f=>{const it=state.items[f.n]||{}; l.push("Mesure "+f.n+" — "+f.t+" : "+LABELS[it.status]+(it.comment?" — "+it.comment.replace(/\s+/g," "):""));});
  return l.join("\n");
}
$('sendForm').addEventListener('submit', e=>{
  e.preventDefault();
  const msg=$('sendMsg'), btn=$('btnSend'); msg.className="msg";
  if($('hp').value){ msg.className="msg ok"; msg.textContent="Évaluation envoyée."; return; } // honeypot : on fait semblant
  const m=state.meta;
  if(!m.org.trim()||!m.nom.trim()||!$('m-email').checkValidity()||!m.email.trim()){
    msg.className="msg err"; msg.textContent="Renseignez l'organisme, votre nom et un e-mail valide (en haut de la page)."; $('m-org').scrollIntoView({behavior:'smooth',block:'center'}); return;
  }
  if(!$('rgpd').checked){ msg.className="msg err"; msg.textContent="Vous devez accepter le traitement de vos données pour envoyer."; return; }
  const payload={type:'contact', contact:{nom:m.nom+" ("+m.org+")", coordonnees:m.email, message:summary(recompute())}, page:location.href};
  btn.disabled=true; btn.textContent="Envoi en cours...";
  fetch(webhook,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(r=>{ if(!r.ok) throw new Error(r.status);
      msg.className="msg ok"; msg.textContent="Évaluation envoyée. Nous revenons vers vous par e-mail."; btn.textContent="Envoyée ✓"; })
    .catch(()=>{ btn.disabled=false; btn.textContent="Envoyer mon évaluation →";
      msg.className="msg err"; msg.textContent="Erreur d'envoi. Exportez le JSON ci-dessous et écrivez-nous via la page contact."; });
});

$('btnReset').addEventListener('click',()=>{
  if(!confirm("Recommencer ? Cela efface toutes vos réponses."))return;
  state=EMPTY(); try{localStorage.removeItem(KEY);}catch(e){}
  fillMeta(); $('rgpd').checked=false; $('sendMsg').textContent=""; $('btnSend').disabled=false; $('btnSend').textContent="Envoyer mon évaluation →";
  render(); window.scrollTo({top:0,behavior:'smooth'});
});
$('btnPrint').addEventListener('click',()=>window.print());
$('btnExport').addEventListener('click',()=>{
  const a=document.createElement('a'), tag=(state.meta.org||"organisme").replace(/[^a-z0-9]+/gi,"_").toLowerCase();
  a.href=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:"application/json"}));
  a.download="audit_cnil_"+tag+"_"+new Date().toISOString().slice(0,10)+".json"; a.click(); URL.revokeObjectURL(a.href);
});
$('btnImport').addEventListener('click',()=>$('importFile').click());
$('importFile').addEventListener('change',ev=>{
  const file=ev.target.files[0]; if(!file)return; const r=new FileReader();
  r.onload=()=>{try{const s=JSON.parse(r.result); if(!(s&&s.items)) throw new Error("Fichier invalide");
    state=Object.assign(EMPTY(),s); state.meta=Object.assign(EMPTY().meta,s.meta); save(); fillMeta(); render();}
    catch(err){alert("Lecture impossible : "+err.message);}};
  r.readAsText(file); ev.target.value="";
});

load(); fillMeta(); render();
</script>
</div>

