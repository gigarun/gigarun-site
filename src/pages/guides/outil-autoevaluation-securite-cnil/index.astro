<script type="application/ld+json" is:inline>{"@context": "https://schema.org", "@type": "TechArticle", "headline": "Auto-évaluation Sécurité des Données — Référentiel CNIL", "image": "https://gigarun.re/images/og-default.png", "description": "Outil d'auto-évaluation de la sécurité des données personnelles basé sur les 25 mesures du guide CNIL. Statut de conformité, commentaires, score et export par GiGaRuN.", "author": {"@type": "Person", "name": "Thomas Cassen", "jobTitle": "DSI externalise & expert cybersecurite", "sameAs": "https://re.linkedin.com/in/thomascassen"}, "publisher": {"@type": "Organization", "name": "Gigarun", "logo": {"@type": "ImageObject", "url": "https://gigarun.re/favicon.ico"}}, "mainEntityOfPage": "https://gigarun.re/guides/outil-autoevaluation-securite-cnil", "datePublished": "2026-06-04T00:00:00+04:00", "dateModified": "2026-06-04T00:00:00+04:00"}</script>
